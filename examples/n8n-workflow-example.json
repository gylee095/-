{
  "name": "Nanobanana Design Prompt Generator",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "generate-prompt",
        "responseMode": "responseNode",
        "options": {}
      },
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "position": [250, 300],
      "webhookId": "generate-prompt"
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "intent",
              "value": "={{ $json.body.intent }}"
            },
            {
              "name": "theme",
              "value": "={{ $json.body.theme }}"
            },
            {
              "name": "style",
              "value": "={{ $json.body.style }}"
            },
            {
              "name": "referenceImageUrl",
              "value": "={{ $json.body.imageUrl || '' }}"
            },
            {
              "name": "additionalInstructions",
              "value": "={{ $json.body.instructions || '' }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Prepare Parameters",
      "type": "n8n-nodes-base.set",
      "position": [450, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3000/api/nanobanana",
        "authentication": "none",
        "sendBody": true,
        "contentType": "application/json",
        "bodyParameters": {
          "parameters": [
            {
              "name": "intent",
              "value": "={{ $json.intent }}"
            },
            {
              "name": "theme",
              "value": "={{ $json.theme }}"
            },
            {
              "name": "style",
              "value": "={{ $json.style }}"
            },
            {
              "name": "referenceImageUrl",
              "value": "={{ $json.referenceImageUrl }}"
            },
            {
              "name": "additionalInstructions",
              "value": "={{ $json.additionalInstructions }}"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "name": "Call Nanobanana API",
      "type": "n8n-nodes-base.httpRequest",
      "position": [650, 300]
    },
    {
      "parameters": {
        "values": {
          "string": [
            {
              "name": "designPrompt",
              "value": "={{ $json.prompt }}"
            },
            {
              "name": "intent",
              "value": "={{ $json.parameters.intent }}"
            },
            {
              "name": "theme",
              "value": "={{ $json.parameters.theme }}"
            },
            {
              "name": "style",
              "value": "={{ $json.parameters.style }}"
            }
          ],
          "number": [
            {
              "name": "inputTokens",
              "value": "={{ $json.usage.input_tokens }}"
            },
            {
              "name": "outputTokens",
              "value": "={{ $json.usage.output_tokens }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Format Response",
      "type": "n8n-nodes-base.set",
      "position": [850, 300]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json }}",
        "options": {}
      },
      "name": "Respond to Webhook",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1050, 300]
    },
    {
      "parameters": {
        "keepOnlySet": true,
        "values": {
          "string": [
            {
              "name": "error",
              "value": "={{ $json.message }}"
            },
            {
              "name": "timestamp",
              "value": "={{ $now }}"
            }
          ]
        },
        "options": {}
      },
      "name": "Format Error",
      "type": "n8n-nodes-base.set",
      "position": [850, 500]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"success\": false, \"error\": $json.error } }}",
        "responseCode": 500,
        "options": {}
      },
      "name": "Error Response",
      "type": "n8n-nodes-base.respondToWebhook",
      "position": [1050, 500]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [
        [
          {
            "node": "Prepare Parameters",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Prepare Parameters": {
      "main": [
        [
          {
            "node": "Call Nanobanana API",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Call Nanobanana API": {
      "main": [
        [
          {
            "node": "Format Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Response": {
      "main": [
        [
          {
            "node": "Respond to Webhook",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Format Error": {
      "main": [
        [
          {
            "node": "Error Response",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {},
  "staticData": null,
  "tags": [],
  "triggerCount": 0
}
