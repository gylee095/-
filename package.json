{
  "name": "korea-early-warning",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "한반도 위기 조기감지 시스템 — 공개 정보(OSINT) 기반 개인용 조기경보 에이전트",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "scan": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts scan",
    "scan:dry": "NODE_USE_ENV_PROXY=1 tsx src/cli.ts scan --dry-run",
    "mcp": "NODE_USE_ENV_PROXY=1 tsx src/mcp/server.ts",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250101.0",
    "@types/node": "^22.10.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
